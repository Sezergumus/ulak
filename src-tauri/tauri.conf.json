{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ulak",
  "version": "0.1.0",
  "identifier": "dev.ulak.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "powershell -NoProfile -File scripts/npm.ps1 run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
